#!/bin/sh
# One Rust entry point for source development and local builds
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN=MinecraftWorker
if [ "${1-}" = stream ]; then
  BIN=MinecraftStream
  shift
  cargo build --quiet --locked --release --manifest-path "$ROOT/stream/Cargo.toml" --target-dir "$ROOT/target/stream" --bin "$BIN"
  exec "$ROOT/target/stream/release/$BIN" "$@"
fi
cargo build --quiet --locked --release --manifest-path "$ROOT/Cargo.toml" --target-dir "$ROOT/target" --bin "$BIN"
exec env -u BEDROCK_BUNDLE BEDROCK_HOME="$ROOT" "$ROOT/target/release/$BIN" "$@"
